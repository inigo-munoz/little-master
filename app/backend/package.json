{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "bundle": "bash ../../scripts/bundle-backend.sh",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "phb:import": "npx tsx src/db/phb-import-cli.ts",
    "phb:import:force": "npx tsx src/db/phb-import-cli.ts --force",
    "mm:import": "npx tsx src/db/monster-import-cli.ts",
    "mm:import:force": "npx tsx src/db/monster-import-cli.ts --force",
    "rules:import": "npx tsx src/db/import-core-rules.ts",
    "rules:import:force": "npx tsx src/db/import-core-rules.ts --force",
    "srd:build-spells": "npx tsx src/db/build-srd-spells-cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd/domain": "workspace:*",
    "@dnd/llm-providers": "workspace:*",
    "@dnd/shared": "workspace:*",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.7",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
